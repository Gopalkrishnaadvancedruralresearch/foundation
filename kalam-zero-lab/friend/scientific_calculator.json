{
  "engine": "Scientific Math & Engineering Engine",
  "description": "Rules, regex patterns, trigonometric degree/radian evaluation tables, constants, and formula syntax for companion bots.",
  "constants": {
    "pi": {
      "symbol": "π",
      "value": 3.141592653589793,
      "speech": "pi is approximately 3.1416"
    },
    "e": {
      "symbol": "e",
      "value": 2.718281828459045,
      "speech": "Euler's number e is approximately 2.7183"
    },
    "c": {
      "symbol": "c",
      "value": 299792458,
      "unit": "m/s",
      "speech": "The speed of light is 299,792,458 meters per second"
    },
    "g": {
      "symbol": "g",
      "value": 9.80665,
      "unit": "m/s²",
      "speech": "Standard gravity is 9.81 meters per second squared"
    }
  },
  "trigonometric_lookup_degrees": {
    "sin": {
      "0": 0.0,
      "30": 0.5,
      "45": 0.7071,
      "60": 0.866,
      "90": 1.0,
      "180": 0.0,
      "270": -1.0,
      "360": 0.0
    },
    "cos": {
      "0": 1.0,
      "30": 0.866,
      "45": 0.7071,
      "60": 0.5,
      "90": 0.0,
      "180": -1.0,
      "270": 0.0,
      "360": 1.0
    },
    "tan": {
      "0": 0.0,
      "30": 0.5774,
      "45": 1.0,
      "60": 1.7321,
      "90": "undefined",
      "180": 0.0,
      "270": "undefined",
      "360": 0.0
    }
  },
  "arithmetic_operators": {
    "add": {
      "symbols": [
        "+",
        "plus",
        "added to",
        "sum of"
      ],
      "js_operator": "+"
    },
    "subtract": {
      "symbols": [
        "-",
        "minus",
        "subtracted from",
        "difference between"
      ],
      "js_operator": "-"
    },
    "multiply": {
      "symbols": [
        "*",
        "x",
        "multiplied by",
        "times",
        "product of"
      ],
      "js_operator": "*"
    },
    "divide": {
      "symbols": [
        "/",
        "divided by",
        "over"
      ],
      "js_operator": "/"
    }
  },
  "functional_patterns": [
    {
      "type": "percentage",
      "regex": "(\\d+(?:\\.\\d+)?)\\s*(?:%|percent)\\s*(?:of)?\\s*(\\d+(?:\\.\\d+)?)",
      "formula": "({p} / 100) * {n}",
      "response_template": "{p}% of {n} is {result}."
    },
    {
      "type": "square_root",
      "regex": "(?:square\\s+root\\s+of|sqrt)\\s*\\(?(\\d+(?:\\.\\d+)?)\\)?",
      "formula": "Math.sqrt({n})",
      "response_template": "The square root of {n} is {result}."
    },
    {
      "type": "trigonometry",
      "regex": "(sin|cos|tan|sine|cosine|tangent)\\s*\\(?(\\d+)\\s*(?:deg|degrees)?\\)?",
      "formula": "evaluate_trig({fn}, {deg})",
      "response_template": "{fn}({deg}°) = {result}."
    },
    {
      "type": "exponent",
      "regex": "(\\d+(?:\\.\\d+)?)\\s*(?:\\^|to the power of|raised to)\\s*(\\d+(?:\\.\\d+)?)",
      "formula": "Math.pow({base}, {exp})",
      "response_template": "{base} to the power of {exp} is {result}."
    },
    {
      "type": "logarithm",
      "regex": "(?:log|logarithm)\\s*(?:base\\s*10)?\\s*of\\s*(\\d+(?:\\.\\d+)?)",
      "formula": "Math.log10({n})",
      "response_template": "Log base 10 of {n} is {result}."
    }
  ],
  "sample_evaluations": [
    {
      "input": "What is 45 + 55?",
      "output": "45 + 55 = 100."
    },
    {
      "input": "What is 150 - 68?",
      "output": "150 - 68 = 82."
    },
    {
      "input": "What is 12 multiplied by 15?",
      "output": "12 * 15 = 180."
    },
    {
      "input": "What is 144 divided by 12?",
      "output": "144 / 12 = 12."
    },
    {
      "input": "What is 25% of 400?",
      "output": "25% of 400 is 100."
    },
    {
      "input": "What is the square root of 144?",
      "output": "The square root of 144 is 12."
    },
    {
      "input": "What is sin 90 degrees?",
      "output": "sin(90°) = 1."
    },
    {
      "input": "What is cos 60 degrees?",
      "output": "cos(60°) = 0.5."
    },
    {
      "input": "What is tan 45 degrees?",
      "output": "tan(45°) = 1."
    }
  ]
}