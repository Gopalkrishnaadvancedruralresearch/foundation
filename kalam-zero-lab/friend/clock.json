{
  "file_number": 6,
  "filename": "clock.json",
  "module": "Temporal & Environmental Engine",
  "description": "Clock, Timezone, Day-of-week, Week of the Year, Season, and Geolocation Weather integration rules.",
  "time_queries": {
    "triggers": [
      "what is the time",
      "what time is it",
      "current time",
      "tell me time",
      "time now",
      "what is the day",
      "which day is it",
      "what day is today",
      "what is today",
      "what date is it",
      "today date",
      "current date",
      "what is the date",
      "which week is this",
      "week of the year",
      "current week",
      "what month is it",
      "which month",
      "current year",
      "what year is it"
    ],
    "speech_templates": {
      "time_only": "It is currently {time}.",
      "day_and_date": "Today is {day_name}, {date_str}.",
      "full_temporal": "It is currently {time} on {day_name}, {date_str}. We are in week {week_number} of {year}."
    }
  },
  "weather_queries": {
    "triggers": [
      "what is the weather",
      "weather report",
      "weather in my place",
      "how is the weather",
      "weather update",
      "temperature now",
      "is it raining",
      "weather today"
    ],
    "open_meteo_api": {
      "endpoint": "https://api.open-meteo.com/v1/forecast",
      "parameters": "current_weather=true&hourly=temperature_2m,relativehumidity_2m,weathercode",
      "explanation": "Free, open API requiring zero API keys, querying device GPS coordinates via navigator.geolocation."
    },
    "weather_code_map": {
      "0": "Clear sky",
      "1": "Mainly clear",
      "2": "Partly cloudy",
      "3": "Overcast",
      "45": "Foggy",
      "48": "Depositing rime fog",
      "51": "Light drizzle",
      "53": "Moderate drizzle",
      "55": "Dense drizzle",
      "61": "Slight rain",
      "63": "Moderate rain",
      "65": "Heavy rain",
      "71": "Slight snow fall",
      "73": "Moderate snow fall",
      "75": "Heavy snow fall",
      "80": "Slight rain showers",
      "81": "Moderate rain showers",
      "82": "Violent rain showers",
      "95": "Thunderstorm"
    }
  }
}